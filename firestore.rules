rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Chaque utilisateur ne peut lire et écrire que ses propres données
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      // Les champs « plan » et « planUntil » (offre Premium) ne sont modifiables que par l'administrateur
      allow create: if request.auth != null && request.auth.uid == uid
        && !request.resource.data.keys().hasAny(['plan', 'planUntil']);
      allow update: if request.auth != null && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['plan', 'planUntil']);
      match /days/{day} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
    // Tout le reste est fermé
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
